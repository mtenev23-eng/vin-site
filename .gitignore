# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# crawler runtime data
/data/*.log
/data/*checkpoint*.json
/data/opendatacar-last-run.json

# Local crawler state
/data/opendatacar-auto-state.json
/data/opendatacar-auto-state.json.backup
/data/opendatacar-progress.json

# Generated audit and model-recovery reports
/data/autobidcar-unsold-audit.json
/data/unknown-models-*.json
/data/unknown-models-*.csv
/indexability-audit.csv
/sitemap-audit-results.csv

# Temporary code comparisons
/*-diff.txt

# Local source backups
*.backup